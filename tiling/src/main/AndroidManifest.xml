<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The bar's Wi-Fi icon. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Brings the launcher's own task back in front for the app menu. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- The kinds of app a key in tiling.conf can open ("browser", "files", …): which app Android has for each. -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_BROWSER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_FILES" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_CALENDAR" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_EMAIL" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_MUSIC" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_CALCULATOR" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_MAPS" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_GALLERY" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_MESSAGING" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_CONTACTS" /></intent>
        <!-- And which app the user picked to open a web page, write mail, show a place or send a message with. -->
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="mailto" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="smsto" /></intent>
    </queries>

    <application>
        <!-- Where the helper process hands itself to the launcher. Exported for it; only the shell user is let in. -->
        <provider
            android:name="dev.gladimdim.tiling.HelperProvider"
            android:authorities="${applicationId}.tiling-helper"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Super shortcuts while an app in a tile has the keyboard. Turned on by the user in Accessibility settings. -->
        <service
            android:name="dev.gladimdim.tiling.TilingKeyService"
            android:exported="true"
            android:label="@string/tiling_keys_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tiling_keys" />
        </service>
    </application>
</manifest>
