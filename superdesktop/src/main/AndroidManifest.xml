<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wake-on-LAN picks the phone's Wi-Fi or Ethernet network for its broadcast (SdWake.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Loads paired computers and page settings in the background at start; not reachable from outside. -->
        <provider
            android:name="dev.gladimdim.superdesktop.SdWarmup"
            android:authorities="${applicationId}.sd-warmup"
            android:exported="false" />

        <!-- Pairs this launcher with a SUPER DESKTOP computer; also takes superdesktop://pair links from the computer's QR. -->
        <activity
            android:name="dev.gladimdim.superdesktop.pair.PairingActivity"
            android:exported="true"
            android:label="Pair SUPER DESKTOP"
            android:taskAffinity="com.gladimdim.sdlauncher.pair"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="superdesktop" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- Android's share menu: text, images and files to a harness on a paired computer. -->
        <activity
            android:name="dev.gladimdim.superdesktop.share.ShareActivity"
            android:exported="true"
            android:label="SUPER DESKTOP"
            android:taskAffinity="com.gladimdim.sdlauncher.share"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>
        <!-- Scans the computer's pairing QR: zxing's scanner, edge to edge and free to rotate. -->
        <activity
            android:name="dev.gladimdim.superdesktop.pair.QrScanActivity"
            android:exported="false"
            android:stateNotNeeded="true"
            android:taskAffinity="com.gladimdim.sdlauncher.pair"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- zxing's own scanner is unused (QrScanActivity replaces it); drop its landscape lock. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:remove="android:screenOrientation" />
    </application>
</manifest>
